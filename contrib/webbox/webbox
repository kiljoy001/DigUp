  <section class="card" id="snarf_js" style="display:none">
    <h2>Snarf</h2>
    <p>Copy the snarf buffer to the clipboard, or the clipboard into it.</p>
    <p>
      <button class="button" onclick="copySnarf()">copy snarf</button>
      <button class="button ghost" onclick="sendSnarf()">snarf</button>
      <button class="button ghost" onclick="sendPlumb()">plumb</button>
    </p>
    <p id="status" class="empty" style="padding:0"></p>
    <script>
    function status(t){ document.getElementById("status").innerText = t }
    function copySnarf(){
      fetch("/snarf").then(r => r.text()).then(t => {
        navigator.clipboard.writeText(t); status("copied")
      }).catch(() => status("failed"))
    }
    function post(path, text){
      return fetch(path + "?d=" + encodeURIComponent(text))
    }
    function sendSnarf(){
      navigator.clipboard.readText().then(t => post("/dosnarf.html", t)).then(() => status("snarfed"))
        .catch(() => status("failed"))
    }
    function sendPlumb(){
      navigator.clipboard.readText().then(t => post("/doplumb.html", t)).then(() => status("plumbed"))
        .catch(() => status("failed"))
    }
    document.getElementById("snarf_nojs").style.display = "none"
    document.getElementById("snarf_js").style.display = ""
    </script>
  </section>
</div>
