	# The metadata card for a digfs result: share, path, unit, score.
	cat <<'EOF' >$webbox/bin/hitmeta.awk
function esc(s){
	gsub(/&/, "\\&amp;", s)
	gsub(/</, "\\&lt;", s)
	gsub(/>/, "\\&gt;", s)
	return s
}
/^path: /{path = substr($0, 7)}
/^share: /{share = substr($0, 8)}
/^kind: /{kind = substr($0, 7)}
/^unit: /{unit = substr($0, 7)}
/^score: /{score = substr($0, 8)}
/^file: /{file = substr($0, 7)}
END{
	printf "<section class=\"hit\"><div class=\"where\">"
	if(share != "")
		printf "<span class=\"share\">%s</span><span class=\"path\">%s</span>", esc(share), esc(substr(path, length(share) + 1))
	else
		printf "<span class=\"path\">%s</span>", esc(path)
	print "</div><div class=\"chips\">"
	if(unit != "") printf "<span class=\"chip\"><b>unit</b> %s</span>", esc(unit)
	if(score != ""){
		split(score, s, " ")
		printf "<span class=\"chip\"><b>score</b> %s</span>", esc(s[1])
	}
	if(kind != "") printf "<span class=\"chip\">%s</span>", esc(kind)
	if(file != "") printf "<span class=\"chip\">%s</span>", esc(file)
	print "</div></section>"
}
EOF

	# One result in a list: where it came from, the numbers, a preview,
	# and the link to the passage.
	cat <<'EOF' >$webbox/bin/hitcard.awk
function esc(s){
	gsub(/&/, "\\&amp;", s)
	gsub(/</, "\\&lt;", s)
	gsub(/>/, "\\&gt;", s)
	return s
}
BEGIN{body = 0; n = 0}
body == 0 {
	if($0 == "---"){ body = 1; next }
	if(substr($0, 1, 6) == "path: ") path = substr($0, 7)
	if(substr($0, 1, 7) == "share: ") share = substr($0, 8)
	if(substr($0, 1, 6) == "kind: ") kind = substr($0, 7)
	if(substr($0, 1, 6) == "unit: ") unit = substr($0, 7)
	if(substr($0, 1, 7) == "score: "){ split(substr($0, 8), s, " "); score = s[1] }
	next
}
body == 1 {
	gsub(/^[ \t]+/, "")
	if($0 == "") next
	snippet = snippet (n++ ? " " : "") $0
	if(length(snippet) > 320) exit
}
END{
	printf "<article class=\"hit\"><div class=\"where\"><a href=\"/f%s/%s\">", q, f
	if(share != "")
		printf "<span class=\"share\">%s</span><span class=\"path\">%s</span>", esc(share), esc(substr(path, length(share) + 1))
	else
		printf "<span class=\"path\">%s</span>", esc(path)
	print "</a></div><div class=\"chips\">"
	if(unit != "") printf "<span class=\"chip\"><b>unit</b> %s</span>", esc(unit)
	if(score != "") printf "<span class=\"chip\"><b>score</b> %s</span>", esc(score)
	if(kind != "") printf "<span class=\"chip\">%s</span>", esc(kind)
	print "</div>"
	if(snippet != "") printf "<p class=\"snippet\">%s…</p>", esc(snippet)
	printf "<p class=\"more\"><a href=\"/f%s/%s\">Read the passage</a></p></article>\n", q, f
}
EOF

