#!/bin/rc
# qpage <web path of a query directory>
pat=$1
root=/usr/web/files
base=$pat
~ $pat '/' && base=''
d=$root^$base
esc=/n/webbox/bin/esc1

cat /n/webbox/header.html
echo $pat | awk -f /n/webbox/bin/crumbs.awk

hits=0
strong=0
timing=()
if(test -f $d/summary){
	hits=`{awk '/^hits:/{print $2}' $d/summary}
	strong=`{awk '/^hits:/{n=$4; gsub(/[^0-9]/, "", n); print n}' $d/summary}
	timing=`{awk '/^embed:/{sub(/^embed: /, ""); print}' $d/summary}
}

echo '<div class="head"><h1 class="title">'
cat $d/query | $esc
echo '</h1><span class="count">'^$hits^' hits</span></div>'

echo '<form class="search" action="/search" method="get">'
echo -n '<input type="search" name="q" value="'
cat $d/query | $esc
echo '" placeholder="search">'
echo '<button class="button" type="submit">search</button></form>'

if(test -f $d/summary)
	echo '<p class="meta">strong' $strong '·' $timing '</p>'

echo '<div class="hits">'
for(f in `{ls $d | sed 's|.*/||' | grep '^[0-9][0-9]-'})
	awk -v 'q='$pat -v 'f='$f -f /n/webbox/bin/hitcard.awk $d^'/'^$f
echo '</div>'

if(~ $hits 0)
	echo '<p class="empty">Nothing matched. Try fewer words, or a broader phrase.</p>'

/n/webbox/bin/recent
cat /n/webbox/footer.html
